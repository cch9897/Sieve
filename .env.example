# Booru Gallery Configuration
# Copy to .env and adjust paths for your environment

# === Data Sources ===
# Path to booru-crawler project (contains dedup.db and downloads/)
CRAWLER_DIR=/path/to/booru-crawler
# DanbooruFinder API endpoint
DANBOORU_API=http://localhost:5001
# Directory for saving liked Danbooru images
DANBOORU_LIKES_DIR=/path/to/danbooru_liked

# === Server ===
HOST=0.0.0.0
PORT=8780

# === Classifier (optional) ===
# Twitter liked images directory (positive training samples)
TWITTER_DIR=/path/to/twitter_likes/liked
# Twitter tags database
TWITTER_TAGS_DB=/path/to/twitter_likes/twitter_tags.db
# XGBoost model path (relative to project root by default)
PREFERENCE_MODEL_PATH=classifier/model.joblib
# CNN model path
CNN_MODEL_PATH=classifier/model_cnn.pt
# Candidates database
CANDIDATES_DB=backend/candidates.db

# === Pack Pipeline (for GPU training dataset export) ===
# ToyServer SSH host (for extract_disliked_remote.py)
TOYSERVER_HOST=192.168.50.20
# Tar index DB path on remote server
TAR_INDEX_DB=/path/to/DanbooruFinder_Backend/cache/tar_index.db
# Temp directory for disliked images
DANBOORU_DISLIKED_DIR=/tmp/danbooru_disliked
